# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# `.env` is git-ignored — never commit real keys.

# Anthropic API key (only needed from Milestone 2 onward, when agents are added).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model used by the agents (Milestone 2+).
ANTHROPIC_MODEL=claude-opus-5-5

# ClinicalTrials.gov API v2 base URL (public; no key required).
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2

# The study this simulation is built around (CALIBRATE).
STUDY_NCT_ID=NCT02260934

# HTTP timeout in seconds for ClinicalTrials.gov requests.
CTGOV_TIMEOUT_SECONDS=30
